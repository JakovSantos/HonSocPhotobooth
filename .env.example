# AUF CCS Honor Society Photobooth Environment Variables

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous Public API Key (safe for client-side use)
VITE_SUPABASE_ANON_KEY=

# Supabase Storage Bucket name (default: photobooth)
VITE_SUPABASE_BUCKET=photobooth

# Public Sharing Base URL for QR codes (e.g. https://auf-ccs-photobooth.vercel.app)
# If left empty, defaults to current window.location.origin
VITE_PUBLIC_URL=
