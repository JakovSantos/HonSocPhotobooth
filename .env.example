# AUF CCS Honor Society Photobooth Environment Variables

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable / Anon Key (safe for public client use)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Storage Bucket (default: photobooth)
VITE_SUPABASE_BUCKET=photobooth

# Public Production URL for QR Codes (e.g. https://auf-ccs-photobooth.vercel.app)
# If left empty, defaults to current window.location.origin
VITE_APP_URL=
